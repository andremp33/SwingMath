# RevenueCat (store subscriptions in the Android and iOS apps). Public SDK
# keys from RevenueCat > Project settings > API keys: appl_... and goog_....
# The app sells the 'default' offering (annual, lifetime and monthly
# packages), which grants the entitlement 'pro'.
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=

# Pro beta: every Pro feature free for everyone. Off unless set to exactly
# 'true'. `npm run build:app` refuses to build without both RevenueCat keys
# unless this is on, so a store build never ships without a way to pay.
VITE_PRO_BETA=

# Optional accounts (Supabase): sync (Pro), community measurements and
# setups. Leave blank and the app has no account features. The anon key is
# public by design; the database rules protect the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The App Store and Google Play reviewers' account (see the README): the only
# email that signs in with a password instead of a code.
VITE_REVIEW_EMAIL=

# The website's address, for the links the store apps share (setups, the
# stringer's sheet). Blank: the GitHub Pages site. Set it when there is a domain.
VITE_SITE_URL=

# The website's store buttons; "coming soon" until they are set.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Shown in the privacy policy, terms and site footer.
VITE_SUPPORT_EMAIL=swing.math@outlook.com
VITE_OWNER_NAME=
# Postal address of whoever runs the app (the privacy policy's controller).
VITE_OWNER_ADDRESS=
