# Lemon Squeezy (web Pro subscription). In your own Lemon Squeezy store,
# create one subscription product with two variants (monthly and annual),
# a free trial and license keys on, then fill these in .env.local. For the
# published site, set the same names as repository variables on GitHub
# (Settings > Secrets and variables > Actions > Variables).
VITE_LS_STORE_ID=
VITE_LS_CHECKOUT_MONTHLY=
VITE_LS_CHECKOUT_ANNUAL=
# Customer portal, where subscribers change plan or cancel:
# https://<your-store>.lemonsqueezy.com/billing
VITE_LS_PORTAL_URL=

# Prices shown in the app. Keep them equal to the store's.
VITE_PRICE_MONTHLY=3.99
VITE_PRICE_ANNUAL=29.99
VITE_PRICE_CURRENCY=EUR
VITE_TRIAL_DAYS=7

# Optional accounts (Supabase): sync (Pro), community measurements and
# setups. Leave blank and the app has no account features. The anon key is
# public by design; the database rules protect the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shown in the privacy policy, terms and site footer.
VITE_SUPPORT_EMAIL=
VITE_OWNER_NAME=
